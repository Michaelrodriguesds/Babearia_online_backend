# =====================================================================
#  COPIE ESTE ARQUIVO PARA ".env" E PREENCHA OS VALORES
#  (o .env NUNCA vai para o GitHub — ele já está no .gitignore)
# =====================================================================

# Porta local da API
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------
# 1) STRING DE CONEXÃO DO MONGODB  (OBRIGATÓRIO)
#    MongoDB Atlas > seu cluster > Connect > Drivers > copie a URI
#    Troque <usuario>, <senha> e o nome do banco (barbearia_saas)
# ---------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/barbearia_saas?retryWrites=true&w=majority

# ---------------------------------------------------------------------
# 2) SEGREDOS  (OBRIGATÓRIO) — gere com:  npm run gerar-chaves
# ---------------------------------------------------------------------
JWT_SECRET=cole_aqui_o_valor_gerado
ENCRYPTION_KEY=cole_aqui_os_64_caracteres_gerados

# Notificações push no celular do barbeiro (GRÁTIS). Também geradas pelo
# "npm run gerar-chaves". Sem elas, os avisos só aparecem no terminal.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=seu@email.com

# ---------------------------------------------------------------------
# 3) ENDEREÇOS
#    FRONTEND_URL: site onde os clientes agendam (pode ter mais de um,
#    separados por vírgula). API_URL: endereço público desta API
#    (no Render fica algo como https://barbearia-api.onrender.com)
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 4) LICENÇA (seu controle como desenvolvedor)
# ---------------------------------------------------------------------
DIAS_TESTE=30
DIAS_PLANO=30
# Seu WhatsApp de suporte (aparece na tela de plano vencido). Só números com DDI.
SUPORTE_WHATSAPP=5521999999999

# ---------------------------------------------------------------------
# 5) WHATSAPP CLOUD API (Meta)  — opcional no começo
#    Se ficar vazio, as mensagens aparecem só no terminal (modo simulado)
#    developers.facebook.com > seu App > WhatsApp > Configuração da API
# ---------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# true = barbeiro recebe avisos também pelo WhatsApp (custa por mensagem).
# false = só push no celular (grátis). Recomendado: false
WHATSAPP_AVISAR_BARBEIRO=false

# ---------------------------------------------------------------------
# 6) PIX VIA MERCADO PAGO — o token de cada barbearia é cadastrado
#    pelo próprio dono no painel (não aqui). Este e-mail só é usado
#    quando o cliente não informa e-mail (o Mercado Pago exige um).
# ---------------------------------------------------------------------
PAGADOR_EMAIL_PADRAO=pagamentos@seudominio.com.br
